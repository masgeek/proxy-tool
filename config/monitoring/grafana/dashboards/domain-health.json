      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Latest probe result for every public hostname.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "index": 0, "text": "DOWN" }, "1": { "color": "green", "index": 1, "text": "UP" } }, "type": "value" }] },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
              { "id": "color", "value": { "mode": "thresholds" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Status Code" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "color-text" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Latency" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Cert Expires In" },
            "properties": [{ "id": "unit", "value": "dtdurations" }]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 20 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Domain" }]
      },
      "targets": [
        { "expr": "probe_success{job=\"blackbox-http\", instance=~\"$domain\"} == bool $status", "format": "table", "instant": true, "legendFormat": "Status", "refId": "A" },
        { "expr": "probe_http_status_code{job=\"blackbox-http\", instance=~\"$domain\"}", "format": "table", "instant": true, "legendFormat": "Status Code", "refId": "B" },
        { "expr": "probe_duration_seconds{job=\"blackbox-http\", instance=~\"$domain\"}", "format": "table", "instant": true, "legendFormat": "Latency", "refId": "C" },
        { "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\", instance=~\"$domain\"} - time()) / 86400", "format": "table", "instant": true, "legendFormat": "Cert Expires In", "refId": "D" }
      ],
      "title": "Per-Domain Status",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "instance", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Job": true,
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "instance": "Domain",
              "Value #A": "Status",
              "Value #B": "Status Code",
              "Value #C": "Latency",
              "Value #D": "Cert Expires In"
            }
          }
        }
      ],
      "type": "table"
    },
