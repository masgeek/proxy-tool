    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Hostnames bucketed by the class of status code returned, so error rates stand out without reading every series.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
