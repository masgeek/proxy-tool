        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "days",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
