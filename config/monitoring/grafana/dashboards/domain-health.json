      "title": "Domains Down",
      "type": "stat",
      "targets": [
        { "expr": "sum(probe_success{job=\"blackbox-http\"} == bool 0)", "legendFormat": "down", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
