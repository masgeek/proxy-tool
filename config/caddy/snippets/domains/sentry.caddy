# -----------------------------------------------------------------------------
# Sentry service (GlitchTip)
# -----------------------------------------------------------------------------
sentry.akilimo.org, sentry.munywele.co.ke {
	tls agwise@akilimo.org
	encode gzip zstd
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy
	import ../errors.caddy
	reverse_proxy 127.0.0.1:9805 {
		import ../headers/proxy-headers.caddy
	}
}
