# -----------------------------------------------------------------------------
# baserow.munywele.co.ke — Baserow operational database
# Host upstream: 127.0.0.1:9730 (stacks/baserow)
# Only the web frontend is published; the API stays inside the stack.
# -----------------------------------------------------------------------------
baserow.munywele.co.ke {
	import ../headers/security-headers.caddy
	import ../errors.caddy

	reverse_proxy 127.0.0.1:9730 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
