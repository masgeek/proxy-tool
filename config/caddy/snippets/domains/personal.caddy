# Personal repository services exposed through the host Caddy instance.

track.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip zstd
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy
	import ../errors.caddy
	reverse_proxy 127.0.0.1:8800 {
		import ../headers/proxy-headers.caddy
	}
	log {
		output file /var/log/caddy/track.log
		format console
	}
}

scrob.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip zstd
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy
	import ../errors.caddy
	reverse_proxy 127.0.0.1:8900 {
		import ../headers/proxy-headers.caddy
	}
	log {
