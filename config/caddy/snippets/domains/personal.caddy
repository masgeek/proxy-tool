paperless.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip zstd
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy
	import ../errors.caddy
	request_body {
		max_size 100MB
	}
	reverse_proxy 127.0.0.1:8890 {
		import ../headers/proxy-headers.caddy
	}
	log {
		output file /var/log/caddy/paperless.log
		format console
	}
}
