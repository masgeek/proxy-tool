# -----------------------------------------------------------------------------
# munywele.co.ke domain group
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# munywele — munywele.co.ke
# Reverse proxy on 127.0.0.1:9200
# -----------------------------------------------------------------------------
munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy

	reverse_proxy 127.0.0.1:9200 {
		import ../headers/proxy-headers.caddy
		#header_up X-Forwarded-Port {server_port}
	}

	log {
		output file /var/log/caddy/munywele.log
		format console
		level debug
	}
}

# -----------------------------------------------------------------------------
# fuelrod API — api.munywele.co.ke + api.tsobu.co.ke
# Reverse proxy on 127.0.0.1:9200
# -----------------------------------------------------------------------------
api.munywele.co.ke, api.tsobu.co.ke {
	tls dev@munywele.co.ke
	encode gzip
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy

	rewrite * /api{uri}

	reverse_proxy 127.0.0.1:9200 {
		import ../headers/proxy-headers.caddy
	}

	log {
		output file /var/log/caddy/fuelrod.log
		format console
		level debug
	}
}

# -----------------------------------------------------------------------------
# ActiveXperts Legacy HTTP Compatibility
#
# ActiveXperts sends requests using plain HTTP and does not correctly handle
# Caddy's HTTP -> HTTPS 308 redirect.
#
# Only /v1/sms/plain requests with an ActiveXperts WinHTTP User-Agent are
# allowed through over HTTP. All other HTTP requests are redirected to HTTPS.
#
# NOTE:
# The User-Agent matcher is a compatibility filter, not a security boundary.
# User-Agent headers can be spoofed.
# -----------------------------------------------------------------------------
http://api.munywele.co.ke, http://api.tsobu.co.ke {
	import ../headers/security-headers.caddy

	@activex {
		path /v1/sms/plain
		header User-Agent "WinHTTP ActiveXperts*"
	}

	handle @activex {
		import ../disallowed-basic.caddy

		rewrite * /api{uri}

		reverse_proxy 127.0.0.1:9200 {
			import ../headers/proxy-headers.caddy
		}
	}

	handle {
		redir https://{host}{uri} 308
	}

	log {
		output file /var/log/caddy/fuelrod-http.log
		format console
		level debug
	}
}

# -----------------------------------------------------------------------------
# fuelrod portal — sms.munywele.co.ke
# Reverse proxy on 127.0.0.1:9201
# -----------------------------------------------------------------------------
sms.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy

	reverse_proxy 127.0.0.1:9201 {
		import ../headers/proxy-headers.caddy
	}

	log {
		output file /var/log/caddy/fuelrod-portal.log
		format console
		level debug
	}
}

portal.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy

	@allowed remote_ip 203.0.113.5 198.51.100.0/24 192.0.2.100

	handle @allowed {
		reverse_proxy 127.0.0.1:9201 {
			import ../headers/proxy-headers.caddy
		}
	}

	handle {
		header Content-Type "application/json"
		respond `{"status":"blocked","error":"suspicious_traffic","message":"Suspicious traffic has been detected from your IP address. Access has been temporarily blocked. If you believe this is an error, please contact support."}` 403
	}

	log {
		output file /var/log/caddy/fuelrod-portal.log
		format console
		level debug
	}
}

