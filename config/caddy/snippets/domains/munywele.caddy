# Cross-domain log and infrastructure dashboards.
logs.munywele.co.ke, logs.akilimo.org {
	tls dev@munywele.co.ke
	encode gzip zstd
	import ../disallowed-basic.caddy
	import ../headers/security-headers.caddy
	reverse_proxy 127.0.0.1:9600 {
		import ../headers/proxy-headers.caddy
	}
	log {
		output file /var/log/caddy/grafana.log
		format console
	}
}

# MQTT broker and dashboard.
mqtt.munywele.co.ke {
	import ../headers/security-headers.caddy

	# EMQX MQTT over Secure WebSockets (WSS)
	# Connection URL: wss://mqtt.munywele.co.ke/mqtt
	@mqtt path /mqtt /mqtt/*
	handle @mqtt {
		reverse_proxy http://127.0.0.1:8083
	}

	# EMQX Web Dashboard
	handle {
		reverse_proxy http://127.0.0.1:18083
	}
}

