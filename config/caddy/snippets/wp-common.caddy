# Common WordPress hardening + static caching + security headers + routing.
# Assumes `root` and `php_fastcgi` are already set in the site block above this import.
encode gzip zstd

@wp_disallowed {
	path /wp-config.php
	path /xmlrpc.php
	path /.htaccess
	path /.git/*
	path /wp-content/uploads/*.php
	path /wp-content/*.log
	path *.sql
}
respond @wp_disallowed 403

@wp_static {
	file
	path *.css *.js *.jpg *.jpeg *.png *.gif *.ico *.svg *.webp *.woff *.woff2 *.ttf *.eot *.otf
}
	header @wp_static Cache-Control "public, max-age=7200"

handle @wp_static {
	cache {
		allowed_http_verbs GET HEAD
			default_cache_control "public, max-age=7200"
			badger {
				path /var/lib/caddy/cache
				configuration {
					syncWrites true
				}
			}
			ttl 2h
			stale 0s
	}
	file_server
}

header {
	X-Content-Type-Options "nosniff"
	X-Frame-Options "SAMEORIGIN"
	Referrer-Policy "strict-origin-when-cross-origin"
	-Server
}

try_files {path} {path}/ /index.php?{query}
file_server
