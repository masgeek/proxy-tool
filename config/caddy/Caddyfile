# The Caddyfile is an easy way to configure your Caddy web server.
{
	admin 172.17.0.1:2019 {
		origins http://localhost:2019 localhost:2019 127.0.0.1:2019 http://:2019
	}

	# Default ACME contact for akilimo.org properties.
	# Overridden per-site below where a different email is needed.
	email akilimo@cgiar.org
}

order rate_limit before basicauth
order cache before reverse_proxy

(security_headers) {
	header Content-Security-Policy "upgrade-insecure-requests"
}

(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
}

(proxy_headers_port) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Port {server_port}
}

(proxy_headers_forwarded) {
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

(proxy_headers_forwarded_port) {
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
	header_up X-Forwarded-Port {server_port}
}

(proxy_headers_forwarded_host_proto) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

(proxy_headers_websocket) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up Connection {>Connection}
	header_up Upgrade {>Upgrade}
}

(proxy_disallowed_basic) {
	@disallowed {
		path /.git/*
		path *.sql
	}
	respond @disallowed "Access Denied" 403
}

(proxy_disallowed_full) {
	@disallowed {
		path /.git/*
		path *.sql
		path /xmlrpc.php
		path_regexp user_ini \.user\.ini
	}
	respond @disallowed "Access Denied" 403
}

import snippets/common.caddy
import snippets/domains/akilimo.caddy
import snippets/domains/munywele.caddy
import snippets/domains/agwise.caddy
