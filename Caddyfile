# -----------------------------------------------------------------------------
# akilimo-dev — app.akilimo.org, dev.akilimo.org
# Reverse proxy to akilimo-api container root on 127.0.0.1:9100
# -----------------------------------------------------------------------------
app.akilimo.org, dev.akilimo.org {
	tls akilimo@cgiar.org
	encode gzip zstd
	import proxy_disallowed_full
	import security_headers

	reverse_proxy 127.0.0.1:9100 {
		import proxy_headers

		transport http {
			dial_timeout 1800s
			response_header_timeout 1800s
		}
	}

	log {
		output file /var/log/caddy/akilimo-app.log
		format console
		level debug
	}
}

# -----------------------------------------------------------------------------
# akilimo-api — api.akilimo.org
# Reverse proxy to akilimo-api container on 127.0.0.1:9100/api
# -----------------------------------------------------------------------------
api.akilimo.org {
	tls akilimo@cgiar.org
	encode gzip
	import proxy_disallowed_full
	import security_headers

	rewrite * /api{uri}

	reverse_proxy 127.0.0.1:9100 {
		import proxy_headers_port

		transport http {
			dial_timeout 1800s
			response_header_timeout 1800s
		}
	}

	log {
		output file /var/log/caddy/akilimo-api.log
		format console
		level debug
	}
}

