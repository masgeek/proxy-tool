	}
}

portal.munywele.co.ke {
	tls dev@munywele.co.ke
	encode gzip
	import proxy_disallowed_basic
	import security_headers

	@allowed remote_ip 203.0.113.5 198.51.100.0/24 192.0.2.100

	handle @allowed {
		reverse_proxy 127.0.0.1:9201 {
			import proxy_headers
		}
	}

	handle {
		header Content-Type "application/json"
		respond `{"status":"blocked","error":"suspicious_traffic","message":"Suspicious traffic has been detected from your IP address. Access has been temporarily blocked. If you believe this is an error, please contact support."}` 403
	}

	log {
		output file /var/log/caddy/fuelrod-portal.log
		format console
		level debug
	}
}

