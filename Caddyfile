	}
}

# -----------------------------------------------------------------------------
# ActiveXperts Legacy HTTP Compatibility
#
# ActiveXperts sends requests using plain HTTP and does not correctly handle
# Caddy's HTTP -> HTTPS 308 redirect.
#
# Only /v1/sms/plain requests with an ActiveXperts WinHTTP User-Agent are
# allowed through over HTTP. All other HTTP requests are redirected to HTTPS.
#
# NOTE:
# The User-Agent matcher is a compatibility filter, not a security boundary.
# User-Agent headers can be spoofed.
# -----------------------------------------------------------------------------
http://api.munywele.co.ke, http://api.tsobu.co.ke {
	import security_headers

	@activex {
		path /v1/sms/plain
		header User-Agent "WinHTTP ActiveXperts*"
	}

	handle @activex {
		import proxy_disallowed_basic

		rewrite * /api{uri}

		reverse_proxy 127.0.0.1:9200 {
			import proxy_headers
		}
	}

	handle {
		redir https://{host}{uri} 308
	}

	log {
		output file /var/log/caddy/fuelrod-http.log
		format console
		level debug
	}
}

