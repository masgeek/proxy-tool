# =============================================================================
# AKILIMO STACK — application environment
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
AKILIMO_TAG=latest
# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
AKILIMO_DOMAIN=akilimo.example.com

# -----------------------------------------------------------------------------
# Application — REQUIRED
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_URL=https://akilimo.example.com
AKILIMO_COMPUTE_BASE_URL=http://172.17.0.1:8001

# Application — optional (defaults shown)
APP_NAME=Akilimo API
APP_ENV=production
APP_DEBUG=false

# -----------------------------------------------------------------------------
# Database — REQUIRED (must match databases stack .env)
# -----------------------------------------------------------------------------
DB_HOST=172.17.0.1
DB_DATABASE=akilimo
DB_USERNAME=akilimo
DB_PASSWORD=change_me
DEFAULT_ADMIN_PASSWORD=change_me

# Database — optional (defaults shown)
DB_CONNECTION=mariadb
DB_PORT=3306
DB_TYPE=mysql

# -----------------------------------------------------------------------------
# Redis — optional (defaults shown)
# -----------------------------------------------------------------------------
# Shared cache instance in the cache stack, logical database 2.
# REDIS_PASSWORD must match stacks/cache/.env (see docs/redis-instances.md)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Cache & session — optional (defaults shown)
# -----------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_TTL=30s
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Queue — optional (defaults shown)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_WORKERS=5
QUEUE_MAX_TRIES=3
QUEUE_TIMEOUT=3600
QUEUE_SLEEP=3
ENV_QUEUE_TIMEOUT=60
AUTO_RECOVER_FAILED_MIGRATIONS=false

# -----------------------------------------------------------------------------
# Logging — optional (defaults shown)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Filesystem — optional (defaults shown)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail — optional (defaults shown; set MAIL_HOST if not using Mailpit)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@akilimo.org
MAIL_FROM_NAME=Akilimo

# =============================================================================
# AKILIMO MCP SERVER (service "mcp", public at akilimo-mcp.akilimo.org)
# Separate AKILIMO_MCP_* names: the DB_* values above belong to the API.
# =============================================================================
# REQUIRED: image tag of ghcr.io/iita-akilimo/akilimo-mcp-agent
AKILIMO_MCP_TAG=latest

# Optional (defaults shown). The API is reached over the internal network.
AKILIMO_MCP_API_BASE_URL=http://akilimo-api/api
AKILIMO_MCP_API_KEY=
AKILIMO_MCP_ALLOWED_ORIGINS=https://akilimo-mcp.akilimo.org

# Optional accounts database on the shared PostgreSQL (databases stack).
# Leave AKILIMO_MCP_DB_HOST empty to run without accounts. The database is not
# created automatically on an existing postgres volume; create it once with:
#   docker exec -it postgres psql -U <user> -c 'CREATE DATABASE akilimo_mcp'
AKILIMO_MCP_DB_HOST=
AKILIMO_MCP_DB_PORT=5432
AKILIMO_MCP_DB_DATABASE=akilimo_mcp
AKILIMO_MCP_DB_USERNAME=
AKILIMO_MCP_DB_PASSWORD=

# Optional admin account ensured at start (needs the database)
AKILIMO_MCP_ADMIN_EMAIL=
AKILIMO_MCP_ADMIN_PASSWORD=
AKILIMO_MCP_ADMIN_NAME=Administrator
AKILIMO_MCP_ADMIN_USERNAME=
