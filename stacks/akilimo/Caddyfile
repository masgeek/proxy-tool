# -----------------------------------------------------------------------------
# akilimo-dev — dev.akilimo.org
# HTTP reverse proxy to the akilimo-api container root on 127.0.0.1:9100
# -----------------------------------------------------------------------------
dev.akilimo.org {
        tls akilimo@cgiar.org

        log {
                output file /var/log/caddy/akilimo-dev.log
                format console
                level debug
        }

        encode zstd gzip

        reverse_proxy 127.0.0.1:9100 {
                import proxy_headers_port

                transport http {
                        dial_timeout            1800s
                        response_header_timeout 1800s
                }
        }

        @disallowed {
                path /.git/*
                path *.sql
                path /xmlrpc.php
                path_regexp user_ini \.user\.ini
        }
        respond @disallowed "Access Denied" 403
}

# -----------------------------------------------------------------------------
# akilimo-api — api.akilimo.org
# HTTP reverse proxy to the akilimo-api container on 127.0.0.1:9100/api
# -----------------------------------------------------------------------------
api.akilimo.org {
        tls akilimo@cgiar.org

        log {
                output file /var/log/caddy/akilimo-api.log
                format console
                level debug
        }

        encode zstd gzip

        rewrite * /api{uri}

        reverse_proxy 127.0.0.1:9100 {
                import proxy_headers_port

                transport http {
                        dial_timeout            1800s
                        response_header_timeout 1800s
                }
        }

        @disallowed {
                path /.git/*
                path *.sql
                path /xmlrpc.php
                path_regexp user_ini \.user\.ini
        }
        respond @disallowed "Access Denied" 403
}
