# =============================================================================
# Caddy configuration for Akilimo stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# akilimo-site — akilimo.org
# PHP-FPM: akilimo-site container via unix socket
# -----------------------------------------------------------------------------
akilimo.org {
        tls akilimo@cgiar.org


        root * /data/extra_storage/services/akilimo
        encode zstd gzip

        @disallowed {
                path /xmlrpc.php
                path *.sql
                path /wp-content/uploads/*.php
                path /.git/*
        }
        respond @disallowed "Access Denied" 403

        # Serve known static asset types directly from disk — never hits PHP-FPM
        @static {
                file
                path *.css *.js *.ico *.gif *.jpg *.jpeg *.png *.svg *.webp *.woff *.woff2 *.ttf *.eot *.otf *.mp4 *.webm *.pdf *.txt *.xml
        }
        handle @static {
                header Cache-Control "public, max-age=7200"
                cache {
                        allowed_http_verbs GET HEAD
                        default_cache_control "public, max-age=7200"
                        ttl 2h
                        stale 0s
                }
                file_server
        }

        # PHP requests
        php_fastcgi unix//run/php/php8.4-fpm.sock

        # WordPress permalink fallback — passes original query string through
        try_files {path} {path}/ /index.php?{query}

        file_server
}

