# Standalone snippet for the baserow stack.
# The host Caddyfile imports the shared copy from config/caddy/snippets/domains/baserow.caddy
# Baserow's web frontend is the only published container; the API stays internal.
baserow.munywele.co.ke {
	import snippets/security-headers.caddy
	import snippets/errors.caddy

	reverse_proxy 127.0.0.1:9730 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
