# -----------------------------------------------------------------------------
# BASEROW STACK — operational database
# Copy to .env and fill in values before starting this stack.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Public URL — must match the Caddy route exactly, or emails and shared links
# are generated with the wrong host.
# -----------------------------------------------------------------------------
BASEROW_PUBLIC_URL=https://baserow.munywele.co.ke

# Leave empty: the frontend reaches the backend inside the stack. Set only if a
# browser ever has to call the API directly.
PUBLIC_BACKEND_URL=

# -----------------------------------------------------------------------------
# Version — pin it. Do not track latest across a data-bearing deployment.
# -----------------------------------------------------------------------------
BASEROW_VERSION=2.3.4

# -----------------------------------------------------------------------------
# Secrets — generate with: openssl rand -base64 48
# SECRET_KEY signs sessions and password-reset links. Losing it logs everyone out
# and invalidates outstanding reset links.
# -----------------------------------------------------------------------------
SECRET_KEY=
# Optional second key so it can be rotated without forcing a re-login.
BASEROW_JWT_SIGNING_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL — shared databases stack.
# Create first: docker exec postgres createdb --username "$POSTGRES_USER" \
#   --owner "$POSTGRES_USER" baserow
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=baserow
DB_USERNAME=baserow
DB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Redis — the shared `redis-jobs` instance, database 3. Celery is a queue, so
# this instance runs noeviction and must never be flushed. REDIS_PASSWORD must
# match REDIS_JOBS_PASSWORD in stacks/cache/.env (docs/redis-instances.md).
# -----------------------------------------------------------------------------
# Baserow reads the index from the URL, not a separate variable. Index 3 is the
# slot allocated to baserow in docs/redis-instances.md.
# Percent-encode any password character that is special in a URL.
REDIS_URL=redis://:change_me@redis-jobs:6379/3
REDIS_HOST=redis-jobs
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# -----------------------------------------------------------------------------
# First account — applied only on the very first start, when the database is
# empty. Leave empty afterwards; the value is ignored once an account exists.
# JSON, one line:
#   {"baserowadmin": {"email":"you@example.com","password":"<strong>","name":"Admin"}}
# -----------------------------------------------------------------------------
BASEROW_INSTALL_JSON=

# -----------------------------------------------------------------------------
# User files — local volume by default.
# To use Alarik instead, uncomment AWS_* in docker-compose.yml and set:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_STORAGE_BUCKET_NAME=baserow,
#   AWS_S3_REGION_NAME=us-east-1, AWS_S3_ENDPOINT_URL=http://s3:8080
# Alarik is addressed path-style; the region must match stacks/s3 S3_REGION.
# Switching backends does not migrate existing files.
# -----------------------------------------------------------------------------

TZ=Africa/Nairobi
STACK_REVISION=1791743363