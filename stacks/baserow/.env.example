# -----------------------------------------------------------------------------
# BASEROW STACK — operational database
# Copy to .env and fill in values before starting this stack.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Public URL — must match the Caddy route exactly, or emails and shared links
# are generated with the wrong host.
# -----------------------------------------------------------------------------
BASEROW_PUBLIC_URL=https://baserow.munywele.co.ke

# -----------------------------------------------------------------------------
# Version — pin it. Do not track latest across a data-bearing deployment.
# -----------------------------------------------------------------------------
BASEROW_VERSION=2.3.4

# -----------------------------------------------------------------------------
# SECRET_KEY signs sessions and password-reset links. Losing it logs everyone out
# and invalidates outstanding reset links. Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
SECRET_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL — shared databases stack.
# Create first: docker exec postgres createdb --username "$POSTGRES_USER" \
#   --owner "$POSTGRES_USER" baserow
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=baserow
DB_USERNAME=baserow
DB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# First account — applied only on the very first start, when the database is
# empty. Leave empty afterwards; the value is ignored once an account exists.
# One line of JSON:
#   {"baserowadmin":{"email":"you@example.com","password":"<strong>","name":"Admin"}}
# -----------------------------------------------------------------------------
BASEROW_INSTALL_JSON=

# -----------------------------------------------------------------------------
# User files go to the baserow-data volume. To use Alarik in stacks/s3 instead,
# uncomment the AWS_* block in docker-compose.yml and set the values here.
# Alarik is path-style and its region must match S3_REGION in stacks/s3.
# Switching backends does not migrate files already stored.
# -----------------------------------------------------------------------------

TZ=Africa/Nairobi
STACK_REVISION=1791743363