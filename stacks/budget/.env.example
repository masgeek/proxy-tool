# Common settings shared by every budget app
APP_URL=https://budget.munywele.co.ke
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_me
TZ=Africa/Nairobi

# PostgreSQL (Actual Budget, Firefly III, Homebox)
DB_CONNECTION=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=actual_budget
DB_USERNAME=actual_budget
DB_PASSWORD=change_me

# Homebox takes a full connection string instead of separate parts.
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=disable
# Example:
DB_CONNECTION_STRING=postgres://homebox:change_me@postgres:5432/homebox?sslmode=disable
# Passwords containing @ : / ? # % must be percent-encoded, e.g. p@ss -> p%40ss.
# Keep the user, host, port and database identical to the DB_* values above when
# switching back and forth.

# Redis (Firefly III)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CACHE_DB=1
CACHE_DRIVER=redis
CACHE_STORE=redis

# Yuvomi
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Leave empty to run without database encryption. If set, the key cannot be
# recovered if lost — store it with your other critical secrets.
DB_ENCRYPTION_KEY=
DB_PATH=/data/yuvomi.db
# Behind Caddy/HTTPS keep this true; TRUST_PROXY=1 trusts a single proxy hop.
SESSION_SECURE=true
TRUST_PROXY=1
BACKUP_ENABLED=true
DOCUMENT_STORAGE_LOCAL_ENABLED=false

# Image tags
YUVOMI_TAG=latest
ACTUAL_TAG=latest
FIREFLY_TAG=latest
HOMEBOX_TAG=latest

STACK_REVISION=1790584804