# Common settings shared by every budget app
APP_URL=https://budget.munywele.co.ke
APP_DOMAIN=budget.munywele.co.ke
APP_PROTOCOL=https
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_me_32_characters_for_firefly
TZ=Africa/Nairobi

# PostgreSQL. Defaults below match Firefly III, the default app.
# Firefly III requires APP_KEY to be exactly 32 characters:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change_me

# Econumo builds DATABASE_URL from the DB_* values above plus this database name.
# Set DATABASE_URL in this file only to override the composed value.
ECONUMO_DB_NAME=econumo
# Public URL; also builds the OAuth callback URL and the link in transactional email
ECONUMO_URL=https://budget.munywele.co.ke
# Create the first user with: docker compose ... exec budget /app/econumo user:create "Name" you@example.com <password>
ECONUMO_ALLOW_REGISTRATION=false
ECONUMO_EMAIL_VERIFICATION=false
# Base currency for multi-currency support. It must exist in the global currency
# list, and a fresh database only has the built-in ones, so the first boot stays on
# USD. Bootstrap sequence:
#   1. docker compose ... up -d budget
#   2. docker compose ... exec budget /app/econumo currency:add KES "Kenyan Shilling" 2
#   3. set ECONUMO_CURRENCY_BASE=KES below, then recreate the service
#   4. optional: docker compose ... exec budget /app/econumo currency:update-rates
ECONUMO_CURRENCY_BASE=USD
ECONUMO_LOG_LEVEL=info
# Optional: Open Exchange Rates token plus refresh interval (0 or unset = off, drive
# rates yourself with the binary's currency:update-rates command)
OPEN_EXCHANGE_RATES_TOKEN=
ECONUMO_CURRENCY_UPDATE_INTERVAL=
MAILER_DSN=

# ezBookkeeping
EBK_DATABASE_TYPE=postgres
EBK_OBJECT_STORAGE_TYPE=local_filesystem
EBK_LOG_MODE=file
# Protect user data. Generate with: openssl rand -base64 32
EBK_SECURITY_SECRET_KEY=change_me
# Config file mounted read-only; it must exist or the app fails at startup.
# The default path is relative to services/ezbookkeeping.yml, where the mount is
# declared. Set an absolute path here if the stack is deployed from another layout.
EBK_CONF_PATH=/ezbookkeeping/conf/ezbookkeeping.ini
EZBOOKKEEPING_CONF=./ezbookkeeping.ini

# Dedicated Redis instance in the cache stack (redis-budget), not shared.
# Firefly III mixes cache, session and queue on it, so it never shares.
REDIS_HOST=redis-budget
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CACHE_DB=0
CACHE_DRIVER=redis
CACHE_STORE=redis

# Yuvomi
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Leave empty to run without database encryption. If set, the key cannot be
# recovered if lost — store it with your other critical secrets.
DB_ENCRYPTION_KEY=
DB_PATH=/data/yuvomi.db
# Behind Caddy/HTTPS keep this true; TRUST_PROXY=1 trusts a single proxy hop.
SESSION_SECURE=true
TRUST_PROXY=1
BACKUP_ENABLED=true
DOCUMENT_STORAGE_LOCAL_ENABLED=false

# Image tags
YUVOMI_TAG=latest
ACTUAL_TAG=latest
FIREFLY_TAG=latest
ECONUMO_TAG=latest
EZBOOKKEEPING_TAG=latest

STACK_REVISION=1791743363