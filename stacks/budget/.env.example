# Common settings shared by every budget app
APP_URL=https://budget.munywele.co.ke
APP_DOMAIN=budget.munywele.co.ke
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_me_32_characters_for_firefly
TZ=Africa/Nairobi

# PostgreSQL. Defaults below match Firefly III, the default app.
# Firefly III requires APP_KEY to be exactly 32 characters:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change_me

# ezBookkeeping
EBK_GLOBAL_MODE=production
# uuid generator; server_id must be unique per instance if a shared generator is used
EBK_UUID_GENERATOR_TYPE=internal
EBK_UUID_SERVER_ID=0
EBK_SERVER_ROOT_URL=https://budget.munywele.co.ke
EBK_DATABASE_TYPE=postgres
# Object storage: Alarik from stacks/s3, reachable in-network as s3:8080.
# Create the bucket by adding it to DEFAULT_BUCKETS in stacks/s3/.env, or in the
# console at https://s3-console.munywele.co.ke, then create an access key for it.
EBK_STORAGE_TYPE=s3
EBK_STORAGE_S3_ENDPOINT=s3:8080
# Must match S3_REGION in stacks/s3 or Alarik rejects the signature.
EBK_STORAGE_S3_REGION=us-east-1
EBK_STORAGE_S3_ACCESS_KEY_ID=
EBK_STORAGE_S3_SECRET_ACCESS_KEY=
EBK_STORAGE_S3_SESSION_TOKEN=
EBK_STORAGE_S3_USE_SSL=false
EBK_STORAGE_S3_SKIP_TLS_VERIFY=false
EBK_STORAGE_S3_USE_PATH_STYLE=true
EBK_STORAGE_S3_BUCKET=ezbookkeeping
EBK_STORAGE_S3_ROOT_PATH=/
EBK_DATABASE_SSL_MODE=disable
EBK_LOG_MODE=console file
# Leave registration on for first setup, or create the user headlessly with
#   exec budget /ezbookkeeping/ezbookkeeping userdata user-add -n name -m email -i nick -p pass -c KES
# then set this to false.
EBK_USER_ENABLE_REGISTER=true
# API tokens are only needed once the ingestion service exists.
EBK_ENABLE_API_TOKEN=false
EBK_API_TOKEN_ALLOWED_REMOTE_IPS=
# Protect user data. Generate with: openssl rand -base64 32
EBK_SECURITY_SECRET_KEY=change_me
# Config file mounted read-only; it must exist or the app fails at startup.
# The default path is relative to services/ezbookkeeping.yml, where the mount is
# declared. Set an absolute path here if the stack is deployed from another layout.
EBK_CONF_PATH=/ezbookkeeping/conf/ezbookkeeping.ini
EZBOOKKEEPING_CONF=./ezbookkeeping.ini

# Dedicated Redis instance in the cache stack (redis-budget), not shared.
# Firefly III mixes cache, session and queue on it, so it never shares.
REDIS_HOST=redis-budget
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CACHE_DB=0
CACHE_DRIVER=redis
CACHE_STORE=redis

# Yuvomi
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Leave empty to run without database encryption. If set, the key cannot be
# recovered if lost — store it with your other critical secrets.
DB_ENCRYPTION_KEY=
DB_PATH=/data/yuvomi.db
# Behind Caddy/HTTPS keep this true; TRUST_PROXY=1 trusts a single proxy hop.
SESSION_SECURE=true
TRUST_PROXY=1
BACKUP_ENABLED=true
DOCUMENT_STORAGE_LOCAL_ENABLED=false

# Image tags
YUVOMI_TAG=latest
ACTUAL_TAG=latest
FIREFLY_TAG=latest
EZBOOKKEEPING_TAG=latest

STACK_REVISION=1791743363