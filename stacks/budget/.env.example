# Common settings shared by every budget app
APP_URL=https://budget.munywele.co.ke
APP_DOMAIN=budget.munywele.co.ke
APP_PROTOCOL=https
APP_ENV=production
APP_DEBUG=false
APP_KEY=MHiF9TI+I2Tf/M9K8UsgG4jEkDTGtC8KnwU2p58HzLAQqVVGoXGEUIR411wA16g3
TZ=Africa/Nairobi

# PostgreSQL (Actual Budget, Firefly III, Econumo, ezBookkeeping, ExpenseOwl)
DB_CONNECTION=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=actual_budget
DB_USERNAME=actual_budget
DB_PASSWORD=change_me

# Econumo and ExpenseOwl build their connection values from DB_* above.
# Set DATABASE_URL / STORAGE_URL in this file only to override that.
# ECONUMO_DB_NAME=econumo
# EXPENSEOWL_DB_NAME=expenseowl
MAILER_DSN=

# ExpenseOwl: STORAGE_URL is derived from DB_HOST/DB_PORT + EXPENSEOWL_DB_NAME
STORAGE_TYPE=postgres
STORAGE_SSL=disable

# ezBookkeeping
EBK_DATABASE_TYPE=postgres
EBK_OBJECT_STORAGE_TYPE=local_filesystem
EBK_LOG_MODE=file

# Redis (Firefly III)
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CACHE_DB=1
CACHE_DRIVER=redis
CACHE_STORE=redis

# Yuvomi
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Leave empty to run without database encryption. If set, the key cannot be
# recovered if lost — store it with your other critical secrets.
DB_ENCRYPTION_KEY=
DB_PATH=/data/yuvomi.db
# Behind Caddy/HTTPS keep this true; TRUST_PROXY=1 trusts a single proxy hop.
SESSION_SECURE=true
TRUST_PROXY=1
BACKUP_ENABLED=true
DOCUMENT_STORAGE_LOCAL_ENABLED=false

# Image tags
YUVOMI_TAG=latest
ACTUAL_TAG=latest
FIREFLY_TAG=latest
ECONUMO_TAG=latest
EZBOOKKEEPING_TAG=latest
EXPENSEOWL_TAG=main

STACK_REVISION=1790584804