# Budget stack — Firefly III
APP_URL=https://budget.munywele.co.ke
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_me_32_characters_for_firefly
TZ=Africa/Nairobi

# PostgreSQL from the shared databases stack.
# Firefly III requires APP_KEY to be exactly 32 characters:
#   head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change_me

# Redis: this stack's dedicated instance in the cache stack, never shared.
# Firefly III uses it for cache, session and queue, so it runs noeviction.
# REDIS_PASSWORD must match REDIS_BUDGET_PASSWORD in stacks/cache/.env
# (see docs/redis-instances.md).
REDIS_HOST=redis-budget
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_CACHE_DB=0

# Behind Caddy, Firefly needs its proxies trusted or generated links lose https.
TRUSTED_PROXIES=**

# Set to false to reject webhook creation entirely.
ALLOW_WEBHOOKS=true

# Image tag
FIREFLY_TAG=latest

STACK_REVISION=1791743363
