# =============================================================================
# AKILIMO MCP STACK - application environment
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# The akilimo stack (the API) must be running: this stack reaches it at http://akilimo-api/api
# over the shared internal network.
# =============================================================================

# =============================================================================
# AKILIMO MCP SERVER (service "mcp", public at akilimo-mcp.akilimo.org)
# AKILIMO_MCP_* names keep it apart from the API's DB_* values in the akilimo stack.
# =============================================================================
# REQUIRED: image tag of ghcr.io/iita-akilimo/akilimo-mcp-agent
AKILIMO_MCP_TAG=latest

# Optional (defaults shown). The API is reached over the internal network.
AKILIMO_MCP_API_BASE_URL=http://akilimo-api/api
AKILIMO_MCP_API_KEY=
AKILIMO_MCP_ALLOWED_ORIGINS=https://akilimo-mcp.akilimo.org,https://agent.akilimo.org

# Master key for the secrets saved in the MCP database (AI provider keys, the web search key, keys of other
# MCP servers), AES-256-GCM. Generate: openssl rand -base64 32. Keep it safe and stable: a different key
# cannot read keys saved earlier. Needs the accounts database; without it only Ollama works in the chat.
AKILIMO_MCP_SECRETS_KEY=

# =============================================================================
# AKILIMO WEB UI (service "web", public at agent.akilimo.org)
# The static web app of the agent (guided forms and AI chat). Its nginx proxies /gateway, /api and /chat
# to the mcp service, so it needs the accounts database above for sign-in and the chat.
# =============================================================================
# Optional: image tag of ghcr.io/iita-akilimo/akilimo-mcp-agent-web (defaults to AKILIMO_MCP_TAG: both
# images are published together)
AKILIMO_WEB_TAG=
# Optional: an Ollama server for the chat's Ollama mode (default: Ollama on the Docker host)
AKILIMO_WEB_OLLAMA_UPSTREAM=http://host.docker.internal:11434

# Optional accounts database on the shared PostgreSQL (databases stack).
# Leave AKILIMO_MCP_DB_HOST empty to run without accounts. The database is not
# created automatically on an existing postgres volume; create it once with:
#   docker exec -it postgres psql -U <user> -c 'CREATE DATABASE akilimo_mcp'
AKILIMO_MCP_DB_HOST=
AKILIMO_MCP_DB_PORT=5432
AKILIMO_MCP_DB_DATABASE=akilimo_mcp
AKILIMO_MCP_DB_USERNAME=
AKILIMO_MCP_DB_PASSWORD=

# Optional admin account ensured at start (needs the database)
AKILIMO_MCP_ADMIN_EMAIL=
AKILIMO_MCP_ADMIN_PASSWORD=
AKILIMO_MCP_ADMIN_NAME=Administrator
AKILIMO_MCP_ADMIN_USERNAME=

# =============================================================================
# WEATHER MCP (service "weather-mcp", internal network only, no public domain)
# Register it in the web UI (Manage) as http://akilimo-weather-mcp:8080/mcp, no key.
# =============================================================================
# Optional: image tag of ghcr.io/iita-akilimo/akilimo-weather-mcp
AKILIMO_WEATHER_TAG=latest
