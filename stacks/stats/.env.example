# Media monitoring stack — Tracearr
#
# The supervised image generates its own secrets on first boot, so there are no
# credentials to fill in here. This file exists for the values that do have
# defaults worth overriding.

TZ=Africa/Nairobi
LOG_LEVEL=info

# Trust one proxy hop for X-Forwarded-*; this container sits behind host Caddy.
TRUST_PROXY=true

# supervised = all-in-one (PostgreSQL 15 + Redis + app in one container)
# latest     = stable, requires external TimescaleDB and Redis
# See README.md before changing this: the volume layouts are not interchangeable.
TRACEARR_TAG=supervised

STACK_REVISION=1792069200