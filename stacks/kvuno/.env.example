# =============================================================================
# KVUNO STACK — application environment
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
KVUNO_TAG=latest

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
KVUNO_DOMAIN=kvuno.agwise.org

# -----------------------------------------------------------------------------
# Flask — optional (defaults shown)
# -----------------------------------------------------------------------------
FLASK_ENV=production
FLASK_APP=production
FLASK_DEBUG=0
DEBUG_DB=0
SORT_JSON=0

# -----------------------------------------------------------------------------
# Logging — optional (defaults shown)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PostgreSQL — REQUIRED (must match databases stack .env)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=kvuno
DB_PASSWORD=change_me
DB_NAME=kvuno

# -----------------------------------------------------------------------------
# Accounts — REQUIRED. Anyone may register; new accounts wait for approval.
# ADMIN_EMAILS (comma-separated) are permanent administrators: they are
# approved at sign-up and approve everyone else in the web app (Accounts).
# -----------------------------------------------------------------------------
ADMIN_EMAILS=admin@example.org

# -----------------------------------------------------------------------------
# Email — optional (activation, rejection and new-registration emails).
# Unset SMTP_HOST/MAIL_FROM = nothing sent; the API log shows "email not sent: SMTP_HOST/MAIL_FROM unset" (logged with user ids, never addresses).
# Mailgun works over SMTP: SMTP_HOST=smtp.mailgun.org, SMTP_USERNAME=postmaster@<domain>
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.org
# MAIL_APP_NAME=KVuno

# -----------------------------------------------------------------------------
# Remote RDS files — optional (semicolon-delimited URLs)
# -----------------------------------------------------------------------------
# REMOTE_RDS_URLS="https://example.com/file.RDS"
# REMOTE_RDS_TOKEN=
# REMOTE_RDS_COOKIES=
# REMOTE_RDS_HEADERS=

# -----------------------------------------------------------------------------
# Ingest checks — optional (defaults shown; applied to kvuno and worker)
# -----------------------------------------------------------------------------
# Hold data-folder files the default mapping cannot import (no lat/lon) as
# "Awaiting mapping" on the Upload page, instead of importing nothing.
# INGEST_HOLD_UNMAPPED=true
# Skip files already imported completely (same SHA-256). false = import again;
# rows already stored are still skipped by the unique constraint.
# INGEST_DUPLICATE_CHECK=true
# Record each skipped duplicate row in import_conflicts (Quality page).
# false = still skipped, just not recorded.
# INGEST_CONFLICT_LOGGING=true

# -----------------------------------------------------------------------------
# Server — optional (defaults shown)
# -----------------------------------------------------------------------------
# SERVER_HOST=0.0.0.0
# SERVER_PORT=5000
