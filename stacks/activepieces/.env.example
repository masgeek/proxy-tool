# =============================================================================
# ACTIVEPIECES STACK — workflow automation
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Public URL used to generate redirect and webhook URLs
AP_FRONTEND_URL=https://flow.munywele.co.ke

# Generate with: openssl rand -hex 16
AP_ENCRYPTION_KEY=
# Generate with: openssl rand -hex 32
AP_JWT_SECRET=

# After setting AP_JWT_SECRET, generate the worker token with:
# npx @activepieces/cli workers token
# Enter the same AP_JWT_SECRET when prompted, then copy the token here.
AP_WORKER_TOKEN=

# Shared PostgreSQL credentials. Create the activepieces database with the
# shared PostgreSQL owner before starting this stack.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Must match the production Redis password; leave empty when Redis auth is off.
REDIS_PASSWORD=
