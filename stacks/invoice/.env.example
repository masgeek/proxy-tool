# Common application settings (shared by every invoicing app)
APP_URL=https://invoice.munywele.co.ke
APP_DOMAIN=invoice.munywele.co.ke
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_me
APP_NAME=InvoiceShelf
ADMIN_USER=admin
ADMIN_PASSWORD=change_me
COMPANY_NAME=Dolibarr Company
COMPANY_COUNTRY_CODE=KE
COOKIE_SECURE=true
ENABLE_HSTS=false
TZ=Africa/Nairobi

# Database (shared maria + cache)
DB_CONNECTION=mariadb
DB_HOST=maria
DB_PORT=3306
DB_DATABASE=invoice
DB_USERNAME=invoice
DB_PASSWORD=change_me
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Optional per-app storage settings
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=240
SCHEDULER_ENABLED=true
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_MIGRATION=false
AUTORUN_LARAVEL_OPTIMIZE=false
PHP_OPCACHE_ENABLE=1
DATABASE_PATH=/app/data/invoice.db
IN_USER_EMAIL=
IN_PASSWORD=

# Image tags
INVOICENINJA_TAG=latest
DOLIBARR_TAG=latest
INKVOICE_TAG=latest
INVOICESHELF_TAG=latest

# Dolibarr image ownership
WWW_USER_ID=33
WWW_GROUP_ID=33

STACK_REVISION=1790584804