# Sentry stack (GlitchTip)
APP_URL=https://sentry.munywele.co.ke
TZ=Africa/Nairobi

# PostgreSQL from the shared databases stack.
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sentry
DB_USERNAME=sentry
DB_PASSWORD=change_me

# Redis from the shared cache stack.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# Sentry-compatible DSN settings
SENTRY_URL=https://sentry.munywele.co.ke
SENTRY_PORT=443
SENTRY_PROTOCOL=https

# Django secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY=change_me_long_random_secret_key_here

# Email settings (change for production)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=noreply@example.com

# Feature flags
ENABLE_ADMIN=False
ENABLE_OPENAPI=False
GLITCHTIP_ENABLE_MCP=False
GLITCHTIP_ENABLE_DUCKDB=False
GLITCHTIP_ENABLE_LOGS=False
GLITCHTIP_ENABLE_UPTIME=False

# Image tag
GLITCHTIP_TAG=latest

STACK_REVISION=1790584804
