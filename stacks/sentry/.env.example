# Sentry stack (GlitchTip)
TZ=Africa/Nairobi

# PostgreSQL from the shared databases stack.
DB_DATABASE=sentry
DB_USERNAME=sentry
DB_PASSWORD=change_me

# Sentry-compatible DSN settings
SENTRY_URL=https://sentry.munywele.co.ke

# Django secret key (generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
DJANGO_SECRET_KEY=change_me_long_random_secret_key_here

# Email settings (change for production)
# Leave EMAIL_URL unset when using the Mailgun API backend below — django-environ
# parses EMAIL_URL and it overrides EMAIL_BACKEND if present.
# EMAIL_URL=consolemail://
EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
DEFAULT_FROM_EMAIL=noreply@example.com

# Mailgun API (anymail) — required when EMAIL_BACKEND is anymail.backends.mailgun.EmailBackend
# Use the Private API key from the Mailgun dashboard (Settings > API Keys), not the
# public validation key.
MAILGUN_API_KEY=
# Must match a domain verified in your Mailgun account.
MAILGUN_SENDER_DOMAIN=
# EU-region Mailgun domain — using the US endpoint causes 403 Forbidden on every send.
MAILGUN_API_URL=https://api.eu.mailgun.net/v3

# Feature flags
ENABLE_ADMIN=False
ENABLE_OPENAPI=False
GLITCHTIP_ENABLE_MCP=False
GLITCHTIP_ENABLE_DUCKDB=False
GLITCHTIP_ENABLE_LOGS=False
GLITCHTIP_ENABLE_UPTIME=False

SERVER_EMAIL=

