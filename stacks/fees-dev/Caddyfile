# =============================================================================
# Caddy configuration for development Fee Syncer
# Copy the block into the host Caddyfile.
# =============================================================================

fees-dev.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/fees-dev.log
                format console
                level debug
        }

        encode gzip
        reverse_proxy 127.0.0.1:9401

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
