# =============================================================================
# CACHE STACK — Redis credentials
# Copy to .env and fill in values before starting this stack.
#
# Five instances, grouped by role. See docs/redis-instances.md for why.
# Generate each password with: openssl rand -base64 32
# =============================================================================

# Shared application caches: fees-prod (db 0), shortener (db 1), akilimo (db 2)
REDIS_PASSWORD=
REDIS_MAXMEMORY=512mb

# Development instances (fees-dev)
REDIS_DEV_PASSWORD=

# Invoice Ninja
REDIS_INVOICE_PASSWORD=
REDIS_INVOICE_MAXMEMORY=256mb

# Firefly III — cache, session and queue on one instance
REDIS_BUDGET_PASSWORD=
REDIS_BUDGET_MAXMEMORY=512mb

# Queues and brokers only: activepieces (db 0), kvuno Celery (db 1), fuelrod (db 2)
REDIS_JOBS_PASSWORD=
REDIS_JOBS_MAXMEMORY=512mb