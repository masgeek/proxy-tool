# =============================================================================
# MONITORING STACK — Grafana, Prometheus, Loki, Grafana Alloy, Beszel
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Domains
GRAFANA_DOMAIN=grafana.example.com
BESZEL_DOMAIN=monitor.example.com

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# Loki
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096
LOKI_LOG_LEVEL=info
LOKI_CACHE_MAX_SIZE_MB=32
LOKI_REJECT_OLD_SAMPLES_AGE=48h
LOKI_MAX_ENTRIES_LIMIT=1000
LOKI_RETENTION_PERIOD=48h
LOKI_MAX_QUERY_LOOKBACK=48h
LOKI_MAX_QUERY_BYTES_READ=128MB
LOKI_QUERY_TIMEOUT=30s
LOKI_MAX_QUERY_PARALLELISM=2
LOKI_TSDB_MAX_QUERY_PARALLELISM=4
LOKI_SPLIT_QUERIES_BY_INTERVAL=30m
LOKI_INGESTION_RATE_MB=5
LOKI_INGESTION_BURST_SIZE_MB=10

# Grafana query proxy limits
GRAFANA_DATAPROXY_TIMEOUT=60
GRAFANA_MAX_CONNS_PER_HOST=20
GRAFANA_MAX_IDLE_CONNECTIONS=20

# Beszel agent — values from the Beszel hub UI (Add System dialog)
BESZEL_KEY=
BESZEL_TOKEN=
BESZEL_HUB_URL=http://beszel:8090
BESZEL_AGENT_PORT=45876
