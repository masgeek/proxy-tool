# =============================================================================
# Caddy configuration for Keycloak stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# keycloak — keycloak.example.com
# HTTP reverse proxy to the keycloak container on 127.0.0.1:9850
# -----------------------------------------------------------------------------
keycloak.example.com {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/keycloak.log
                format console
                level debug
        }

        encode zstd gzip

        reverse_proxy 127.0.0.1:9850 {
                import proxy_headers_forwarded_host_proto
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
