# =============================================================================
# Caddy configuration for Automation stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# n8n — n8n.munywele.co.ke
# HTTP reverse proxy to the n8n container on 127.0.0.1:9700
# -----------------------------------------------------------------------------
n8n.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/n8n.log
                format console
                level debug
        }

        encode zstd gzip

        reverse_proxy 127.0.0.1:9700 {
                import proxy_headers_websocket
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
