# =============================================================================
# BESZEL STACK — hub and host agent
# Copy to .env and fill in values before starting this stack.
# =============================================================================

BESZEL_TAG=latest
BESZEL_AGENT_TAG=latest
# Create a universal token in the Beszel hub under Settings -> Tokens.
# The agent uses it to auto-register without a per-system public key.
BESZEL_UNIVERSAL_TOKEN=
BESZEL_HUB_PORT=9625
BESZEL_AGENT_PORT=45876

BESZEL_HUB_MEMORY_LIMIT=512m
BESZEL_HUB_CPU_LIMIT=0.5
BESZEL_AGENT_MEMORY_LIMIT=128m
BESZEL_AGENT_CPU_LIMIT=0.25
