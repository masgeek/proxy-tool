# =============================================================================
# FEES PROD STACK
# Copy to .env and fill in values before starting this stack.
# =============================================================================

SYNCER_TAG=latest
APP_NAME=Fee Syncer
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://fees.munywele.co.ke

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0

AGENT_MQTT_ENABLED=true
AGENT_MQTT_HOST=mqtt
AGENT_MQTT_PORT=1883
AGENT_MQTT_CLIENT_ID=fee-prod
AGENT_MQTT_TOPIC_PREFIX=fee-syncer/agent
AGENT_MQTT_USERNAME=
AGENT_MQTT_PASSWORD=
AGENT_MQTT_TLS=false
